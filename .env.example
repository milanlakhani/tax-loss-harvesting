APP_ENV=local
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance

# Phase 2 live providers — unused in Phase 1. Do not commit real secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_LLM_ORCHESTRATOR=true

# Optional LLM observability. Disabled and content-redacted by default.
# Missing credentials or exporter outages never block agents, Eval, or paper orders.
# US cloud: https://cloud.langfuse.com  EU cloud: https://cloud.langfuse.eu
# Compose: set these on the backend only. MCP and Streamlit override them to empty.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_TRACING_ENVIRONMENT=local
ALPHA_VANTAGE_API_KEY=
COINGECKO_API_PLAN=demo
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
ALPACA_ACCOUNT_1_NAME=conservative-demo
ALPACA_ACCOUNT_1_KEY=
ALPACA_ACCOUNT_1_SECRET=
ALPACA_ACCOUNT_2_NAME=growth-demo
ALPACA_ACCOUNT_2_KEY=
ALPACA_ACCOUNT_2_SECRET=
ALPACA_PAPER=true
# Current EQUITY/ETF quotes use this Alpaca market-data feed: iex (default), sip, delayed_sip, or otc.
ALPACA_MARKET_DATA_FEED=iex
USE_LIVE_PROVIDERS=false
ENABLE_PAPER_ORDERS=false

# WhatsApp Cloud API / click-to-chat demo. Digits only, including country code.
# The QR opens a read-only conversation; it is not a WhatsApp Web login QR.
WHATSAPP_PHONE_NUMBER=
WHATSAPP_DEFAULT_MESSAGE=Hello Northstar, show my portfolio summary.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Comma-separated inbound phone numbers, digits only. Unknown senders are rejected.
WHATSAPP_ALLOWED_SENDERS=
WHATSAPP_DEFAULT_USER_ID=11111111-1111-4111-8111-111111111111
# Set this to the version displayed by your Meta developer application.
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com

DEMO_SESSION_SIGNING_SECRET=change-me

# Backend Agents SDK client URL for the standalone FastMCP container.
# Docker Compose sets http://mcp:8001/mcp. AWS ECS sidecar uses http://127.0.0.1:8001/mcp.
# Host uvicorn without Compose should use the loopback default below.
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# AWS/CDK only. Do not set this for APP_ENV=local or Docker Compose.
# ALLOWED_IPV4_CIDR=203.0.113.10/32
# APP_ENV=aws
# STATEMENTS_BUCKET=
# DYNAMODB_TABLE=finance-rolling-windows
# AWS_REGION=eu-west-2
# APP_SECRET_ARN=

# Deterministic analysis configuration
ISOLATION_FOREST_SEED=42
ISOLATION_FOREST_CONTAMINATION=0.06
MIN_HISTORY_THRESHOLD=80
MIN_LOSS_THRESHOLD=50.00
PRICE_WINDOW_DAYS=60
ANOMALY_WINDOW_DAYS=180
WINDOW_OVERLAP_HOURS=24
QUOTE_MAX_AGE_MINUTES=15
DEMO_STATEMENT_MAX_AGE_DAYS=20
LOCAL_DATA_DIR=local-data

# Demo clock. historical = 2024 regression fixtures. current uses DEMO_AS_OF_DATE.
# Tests must set a fixed DEMO_AS_OF_DATE. Interactive local or AWS demo may use today.
# Current-demo analysis uses the persisted seed as-of when that dataset exists.
DEMO_MODE=historical
DEMO_AS_OF_DATE=2026-08-28
